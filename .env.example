# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — NEVER commit real tokens.
#
#   cp .env.example .env
#
# Canvas integration is entirely optional. Without it the app still runs
# and answers questions from the public campus knowledge base.

# Your school's Canvas host. Must match where the token was generated.
#   UC Berkeley:  https://bcourses.berkeley.edu
#   Instructure-hosted example: https://ucommons.instructure.com
CANVAS_BASE_URL=

# Personal access token. Generate one in Canvas:
#   Account > Settings > Approved Integrations > "+ New Access Token"
# This is NOT your password. It only grants access to data your own
# account can already see, and you can revoke it from the same page at
# any time. Set a short expiry if you're only testing.
CANVAS_API_TOKEN=

# ---- Optional model/config overrides (defaults shown) ----
# OLLAMA_MODEL=qwen2.5:3b-instruct
# OLLAMA_BASE_URL=http://localhost:11434
# LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5
# CHROMA_PERSIST_DIR=chroma_db
# FORCE_REINDEX=1
